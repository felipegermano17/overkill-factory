{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overkill-factory.dev/schemas/product-experience-evidence-stack.schema.json",
  "title": "Product Experience Evidence Stack",
  "type": "object",
  "required": ["$schema", "record_type", "stack_id", "design_system_ref", "product_face_result_required", "visual_evidence", "accessibility_evidence", "performance_note", "readback_required"],
  "properties": {
    "$schema": { "const": "https://overkill-factory.dev/schemas/product-experience-evidence-stack.schema.json" },
    "record_type": { "const": "product_experience_evidence_stack" },
    "stack_id": { "type": "string", "minLength": 3 },
    "design_system_ref": { "type": "string", "minLength": 3 },
    "product_face_result_required": { "type": "boolean" },
    "visual_evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "accessibility_evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "performance_note": { "type": "string", "minLength": 10 },
    "readback_required": { "type": "boolean" }
  },
  "additionalProperties": false
}
