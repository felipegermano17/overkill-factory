{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overkill-factory.dev/schemas/factory-v3-release-readiness.schema.json",
  "title": "Factory V3 Release Readiness",
  "type": "object",
  "required": [
    "$schema",
    "record_type",
    "readiness_id",
    "created_at",
    "release_target",
    "readiness_tracks",
    "human_gate_package",
    "receipt_five_policy",
    "product_truth_policy",
    "authority_policy",
    "public_github_policy",
    "factory_perfect_run_policy",
    "acceptance"
  ],
  "properties": {
    "$schema": {"const": "https://overkill-factory.dev/schemas/factory-v3-release-readiness.schema.json"},
    "record_type": {"const": "factory_v3_release_readiness"},
    "readiness_id": {"type": "string", "minLength": 3},
    "created_at": {"type": "string", "minLength": 10},
    "release_target": {"const": "V3"},
    "readiness_tracks": {"type": "array", "minItems": 6, "items": {"type": "object", "required": ["id", "name", "evidence_refs"], "properties": {"id": {"type": "string", "minLength": 3}, "name": {"type": "string", "minLength": 3}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}}, "additionalProperties": false}},
    "human_gate_package": {"type": "object"},
    "receipt_five_policy": {"type": "object"},
    "product_truth_policy": {"type": "object"},
    "authority_policy": {"type": "object"},
    "public_github_policy": {"type": "object"},
    "factory_perfect_run_policy": {"type": "object"},
    "acceptance": {"type": "object"}
  },
  "additionalProperties": false
}
