{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overkill-factory.dev/schemas/factory-master-plan-completion.schema.json",
  "title": "Factory Master Plan Completion",
  "type": "object",
  "required": ["$schema", "record_type", "completion_version", "source_plan_ref", "waves", "final_checks"],
  "properties": {
    "$schema": { "const": "https://overkill-factory.dev/schemas/factory-master-plan-completion.schema.json" },
    "record_type": { "const": "factory_master_plan_completion" },
    "completion_version": { "const": "v3.0.0-master-plan-100" },
    "source_plan_ref": { "type": "string", "minLength": 20 },
    "waves": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["wave", "name", "status", "score", "implementation_kinds", "evidence"],
        "properties": {
          "wave": { "type": "integer", "minimum": 0, "maximum": 9 },
          "name": { "type": "string", "minLength": 3 },
          "status": { "const": "implemented" },
          "score": { "const": 100 },
          "implementation_kinds": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 3 } },
          "evidence": {
            "type": "object",
            "required": ["code_refs", "test_refs", "command_refs", "runtime_refs", "agent_refs", "operator_refs", "evidence_refs"],
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 3 }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "final_checks": {
      "type": "object",
      "required": ["all_waves_score_100", "factory_perfect_run_passed", "agents_and_bindings_updated", "factoryctl_commands_exposed", "adapter_runtime_enforced", "human_gate_artifact_first", "receipt_five_anti_overclaim"],
      "properties": {
        "all_waves_score_100": { "type": "boolean" },
        "factory_perfect_run_passed": { "type": "boolean" },
        "agents_and_bindings_updated": { "type": "boolean" },
        "factoryctl_commands_exposed": { "type": "boolean" },
        "adapter_runtime_enforced": { "type": "boolean" },
        "human_gate_artifact_first": { "type": "boolean" },
        "receipt_five_anti_overclaim": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
