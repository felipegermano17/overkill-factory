{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overkill-factory.dev/schemas/factory-bridge-source-envelope.schema.json",
  "title": "Overkill Factory Bridge Source Envelope",
  "type": "object",
  "required": [
    "$schema",
    "record_type",
    "run_id",
    "operator_goal",
    "project_mode",
    "created_by",
    "created_at",
    "source_items",
    "source_handling",
    "target_board_policy",
    "handoff_to_factory",
    "start_readiness",
    "forbidden_bridge_actions",
    "authority"
  ],
  "properties": {
    "$schema": {
      "const": "https://overkill-factory.dev/schemas/factory-bridge-source-envelope.schema.json"
    },
    "record_type": { "const": "factory_bridge_source_envelope" },
    "run_id": { "type": "string", "minLength": 3 },
    "operator_goal": { "type": "string", "minLength": 3 },
    "project_mode": {
      "type": "string",
      "enum": ["new_project", "existing_project"]
    },
    "created_by": { "type": "string", "minLength": 2 },
    "created_at": { "type": "string", "minLength": 10 },
    "operator_language_policy": {
      "type": "object",
      "required": [
        "primary_language",
        "user_facing_surfaces_follow_primary_language",
        "kanban_cards_follow_primary_language",
        "decision_packages_follow_primary_language",
        "internal_factory_surfaces_may_use_english"
      ],
      "properties": {
        "primary_language": { "type": "string", "minLength": 2 },
        "user_facing_surfaces_follow_primary_language": { "const": true },
        "kanban_cards_follow_primary_language": { "const": true },
        "decision_packages_follow_primary_language": { "const": true },
        "internal_factory_surfaces_may_use_english": { "const": true }
      },
      "additionalProperties": true
    },
    "source_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_ref",
          "source_role",
          "received_as",
          "content_embedded",
          "bridge_summary_created",
          "bridge_interpretation_created"
        ],
        "properties": {
          "source_ref": { "type": "string", "minLength": 1 },
          "source_role": { "const": "operator_supplied_material" },
          "received_as": { "const": "opaque_ref" },
          "content_embedded": { "const": false },
          "bridge_summary_created": { "const": false },
          "bridge_interpretation_created": { "const": false }
        },
        "additionalProperties": false
      }
    },
    "source_handling": {
      "type": "object",
      "required": [
        "sealed_raw_materials",
        "bridge_summarized_material",
        "bridge_interpreted_material",
        "bridge_selected_scope",
        "factory_owns_source_resolution",
        "factory_owns_product_sot"
      ],
      "properties": {
        "sealed_raw_materials": { "const": true },
        "bridge_summarized_material": { "const": false },
        "bridge_interpreted_material": { "const": false },
        "bridge_selected_scope": { "const": false },
        "factory_owns_source_resolution": { "const": true },
        "factory_owns_product_sot": { "const": true }
      },
      "additionalProperties": false
    },
    "target_board_policy": {
      "type": "object",
      "required": [
        "policy",
        "requires_new_hermes_board",
        "existing_board_ref",
        "requires_explicit_existing_board_ref",
        "board_creation_owner",
        "factory_start_path_required",
        "bridge_may_select_existing_board",
        "bridge_may_mutate_board"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "enum": ["factory_must_create_new_board", "use_explicit_existing_board"]
        },
        "requires_new_hermes_board": { "type": "boolean" },
        "existing_board_ref": { "type": ["string", "null"] },
        "requires_explicit_existing_board_ref": { "type": "boolean" },
        "board_creation_owner": {
          "type": "string",
          "enum": ["factory_start_path", "existing_runtime"]
        },
        "factory_start_path_required": { "const": true },
        "bridge_may_select_existing_board": { "const": false },
        "bridge_may_mutate_board": { "const": false }
      },
      "additionalProperties": false
    },
    "handoff_to_factory": {
      "type": "object",
      "required": [
        "gateway_profile",
        "orchestrator_worker",
        "handoff_contract",
        "bridge_may_execute_recipient_work",
        "bridge_may_create_hermes_board",
        "factory_start_path_required"
      ],
      "properties": {
        "gateway_profile": { "const": "overkill-factory-gerente" },
        "orchestrator_worker": { "const": "factory-orchestrator" },
        "handoff_contract": { "const": "factory_bridge_start_request" },
        "bridge_may_execute_recipient_work": { "const": false },
        "bridge_may_create_hermes_board": { "const": false },
        "factory_start_path_required": { "const": true }
      },
      "additionalProperties": false
    },
    "start_readiness": {
      "type": "object",
      "required": ["ready_to_request_factory_start", "blocked_reasons"],
      "properties": {
        "ready_to_request_factory_start": { "type": "boolean" },
        "blocked_reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "forbidden_bridge_actions": {
      "type": "array",
      "items": { "type": "string", "minLength": 3 }
    },
    "authority": {
      "type": "object",
      "required": [
        "bridge_may_summarize_source_material",
        "bridge_may_interpret_source_material",
        "bridge_may_select_scope",
        "factory_owns_source_resolution",
        "factory_owns_product_sot"
      ],
      "properties": {
        "bridge_may_summarize_source_material": { "const": false },
        "bridge_may_interpret_source_material": { "const": false },
        "bridge_may_select_scope": { "const": false },
        "factory_owns_source_resolution": { "const": true },
        "factory_owns_product_sot": { "const": true }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "project_mode": { "const": "new_project" }
        }
      },
      "then": {
        "properties": {
          "target_board_policy": {
            "properties": {
              "policy": { "const": "factory_must_create_new_board" },
              "requires_new_hermes_board": { "const": true },
              "existing_board_ref": { "const": null },
              "requires_explicit_existing_board_ref": { "const": false },
              "board_creation_owner": { "const": "factory_start_path" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "project_mode": { "const": "existing_project" }
        }
      },
      "then": {
        "properties": {
          "target_board_policy": {
            "properties": {
              "policy": { "const": "use_explicit_existing_board" },
              "requires_new_hermes_board": { "const": false },
              "existing_board_ref": { "type": "string", "minLength": 3 },
              "requires_explicit_existing_board_ref": { "const": true },
              "board_creation_owner": { "const": "existing_runtime" }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
