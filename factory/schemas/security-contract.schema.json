{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overkill-factory.dev/schemas/security-contract.schema.json",
  "title": "Overkill Factory Security Contract",
  "type": "object",
  "required": ["security_boundary"],
  "properties": {
    "$schema": {
      "const": "https://overkill-factory.dev/schemas/security-contract.schema.json"
    },
    "record_type": {
      "const": "security_contract"
    },
    "security_boundary": {
      "type": "string",
      "minLength": 3
    },
    "security_receipt_ref": {
      "type": "string",
      "minLength": 3
    },
    "risk_class": {
      "enum": ["R0", "R1", "R2", "R3", "R4"]
    },
    "security_owner": {
      "type": "string",
      "minLength": 3
    },
    "required_reviews": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "required_controls": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "secret_policy_ref": {
      "type": "string",
      "minLength": 3
    },
    "supply_chain_proof_ref": {
      "type": "string",
      "minLength": 3
    },
    "human_gate_required": {
      "type": "boolean"
    },
    "secret_access": {
      "enum": ["forbidden", "not_required", "requires_human_gate", "allowed_by_security_contract"]
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
