{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overkill-factory.dev/schemas/human-gate-packet.schema.json",
  "title": "Overkill Factory Human Gate Packet",
  "type": "object",
  "required": [
    "gate_type",
    "required_approvers",
    "decision_state",
    "risk_owner",
    "security_owner",
    "rollback_owner",
    "waiver_policy",
    "operator_briefing_package_ref",
    "approval_request_ref",
    "evidence_index_ref",
    "owner_review_ref",
    "required_decision_assets",
    "optional_explainer_assets",
    "decision_package_delivery"
  ],
  "properties": {
    "gate_type": { "type": "string", "minLength": 3 },
    "required_approvers": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 }
    },
    "decision_state": { "type": "string", "minLength": 3 },
    "risk_owner": { "type": "string", "minLength": 2 },
    "security_owner": { "type": "string", "minLength": 2 },
    "rollback_owner": { "type": "string", "minLength": 2 },
    "waiver_policy": { "type": "string", "minLength": 3 },
    "operator_briefing_package_ref": { "type": "string", "minLength": 3 },
    "approval_request_ref": { "type": "string", "minLength": 3 },
    "evidence_index_ref": { "type": "string", "minLength": 3 },
    "owner_review_ref": { "type": "string", "minLength": 3 },
    "required_decision_assets": {
      "type": "array",
      "items": {
        "enum": [
          "markdown_document",
          "pdf_document",
          "approval_request_json",
          "evidence_index_json",
          "owner_review_markdown"
        ]
      }
    },
    "optional_explainer_assets": {
      "type": "array",
      "items": {
        "enum": [
          "diagram",
          "video_explainer",
          "animation_html",
          "audio_explainer"
        ]
      }
    },
    "decision_package_delivery": {
      "type": "object",
      "required": [
        "operator_interface",
        "primary_language",
        "push_required",
        "summary_only_forbidden",
        "material_before_question",
        "attachment_order",
        "delivery_receipt_ref",
        "question_after_material_delivery"
      ],
      "properties": {
        "operator_interface": {
          "enum": ["telegram", "discord", "cockpit", "cli", "api"]
        },
        "primary_language": { "enum": ["pt-BR", "en-US"] },
        "push_required": { "const": true },
        "summary_only_forbidden": { "const": true },
        "material_before_question": { "const": true },
        "attachment_order": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 3 }
        },
        "delivery_receipt_ref": { "type": "string", "minLength": 3 },
        "question_after_material_delivery": { "const": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
