{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overkill-factory.dev/schemas/factory-runtime-truth-spine.schema.json",
  "title": "Factory Runtime Truth Spine",
  "type": "object",
  "required": [
    "$schema",
    "record_type",
    "spine_id",
    "created_at",
    "runtime_authority",
    "state_equivalence_policy",
    "worker_lifecycle_states",
    "parent_resume_policy",
    "factory_run_links",
    "acceptance"
  ],
  "properties": {
    "$schema": {"const": "https://overkill-factory.dev/schemas/factory-runtime-truth-spine.schema.json"},
    "record_type": {"const": "factory_runtime_truth_spine"},
    "spine_id": {"type": "string", "minLength": 3},
    "created_at": {"type": "string", "minLength": 10},
    "runtime_authority": {
      "type": "object",
      "required": ["hermes_kanban_owns_runtime", "factory_owns_scheduler", "factory_owns_queue", "factory_owns_dispatch", "factory_owns_task_lifecycle", "factory_allowed_scope"],
      "properties": {
        "hermes_kanban_owns_runtime": {"type": "boolean"},
        "factory_owns_scheduler": {"type": "boolean"},
        "factory_owns_queue": {"type": "boolean"},
        "factory_owns_dispatch": {"type": "boolean"},
        "factory_owns_task_lifecycle": {"type": "boolean"},
        "factory_allowed_scope": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 3}}
      },
      "additionalProperties": false
    },
    "state_equivalence_policy": {
      "type": "object",
      "required": ["worker_packet_created", "hermes_dispatch_requested", "hermes_task_running", "worker_result_consumable"],
      "properties": {
        "worker_packet_created": {"type": "string", "minLength": 3},
        "hermes_dispatch_requested": {"type": "string", "minLength": 3},
        "hermes_task_running": {"type": "string", "minLength": 3},
        "worker_result_consumable": {"type": "string", "minLength": 3}
      },
      "additionalProperties": false
    },
    "worker_lifecycle_states": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/lifecycle_state"}},
    "parent_resume_policy": {
      "type": "object",
      "required": ["requires_durable_dependency_edges", "requires_child_result_consumable", "required_readbacks", "forbidden_parent_resume_conditions"],
      "properties": {
        "requires_durable_dependency_edges": {"type": "boolean"},
        "requires_child_result_consumable": {"type": "boolean"},
        "required_readbacks": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 3}},
        "forbidden_parent_resume_conditions": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 3}}
      },
      "additionalProperties": false
    },
    "factory_run_links": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 3}},
    "acceptance": {
      "type": "object",
      "required": ["packet_not_execution", "no_mini_hermes", "dependency_edges_required", "hermes_state_readback_required"],
      "properties": {
        "packet_not_execution": {"type": "boolean"},
        "no_mini_hermes": {"type": "boolean"},
        "dependency_edges_required": {"type": "boolean"},
        "hermes_state_readback_required": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "lifecycle_state": {
      "type": "object",
      "required": ["id", "authority", "meaning", "proof_required"],
      "properties": {
        "id": {"type": "string", "minLength": 3},
        "authority": {"enum": ["factory_contract", "hermes_kanban", "worker_result"]},
        "meaning": {"type": "string", "minLength": 8},
        "proof_required": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
      },
      "additionalProperties": false
    }
  }
}
