{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overkill-factory.dev/schemas/factory-operating-system-scorecard.schema.json",
  "title": "Overkill Factory Operating System Scorecard",
  "type": "object",
  "required": [
    "$schema",
    "record_type",
    "scorecard_id",
    "registry_ref",
    "result",
    "p0_total",
    "p0_blocked",
    "os_results",
    "completion_claim_policy",
    "public_private_boundary"
  ],
  "properties": {
    "$schema": {
      "const": "https://overkill-factory.dev/schemas/factory-operating-system-scorecard.schema.json"
    },
    "record_type": {
      "const": "factory_operating_system_scorecard"
    },
    "scorecard_id": {
      "type": "string",
      "minLength": 3
    },
    "registry_ref": {
      "type": "string",
      "minLength": 3
    },
    "completion_audit_ref": {
      "type": ["string", "null"],
      "minLength": 3
    },
    "runtime_proof_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "uniqueItems": true
    },
    "result": {
      "enum": ["PASS", "BLOCKED"]
    },
    "p0_total": {
      "type": "integer",
      "minimum": 1
    },
    "p0_blocked": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "uniqueItems": true
    },
    "os_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "os_id",
          "display_name",
          "priority",
          "issue_url",
          "registry_status",
          "readiness_state",
          "completion_audit_blockers_owned",
          "active_completion_audit_blockers",
          "runtime_proof_state",
          "runtime_proof_refs",
          "blocking_findings",
          "next_action"
        ],
        "properties": {
          "os_id": {
            "type": "string",
            "minLength": 3
          },
          "display_name": {
            "type": "string",
            "minLength": 3
          },
          "priority": {
            "enum": ["P0", "P1"]
          },
          "issue_url": {
            "type": "string",
            "minLength": 10
          },
          "registry_status": {
            "enum": ["planned", "active", "hardened_existing", "blocked_pending_runtime_proof"]
          },
          "readiness_state": {
            "enum": ["READY_BY_CONTRACT", "ATTENTION", "BLOCKED"]
          },
          "completion_audit_blockers_owned": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3
            },
            "uniqueItems": true
          },
          "active_completion_audit_blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3
            },
            "uniqueItems": true
          },
          "runtime_proof_state": {
            "enum": ["NOT_REQUIRED", "MISSING", "PROVEN"]
          },
          "runtime_proof_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3
            },
            "uniqueItems": true
          },
          "blocking_findings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3
            },
            "uniqueItems": true
          },
          "next_action": {
            "type": "string",
            "minLength": 3
          }
        },
        "additionalProperties": false
      }
    },
    "completion_claim_policy": {
      "type": "object",
      "required": [
        "scorecard_alone_allows_completion_claim",
        "product_specific_production_claim_allowed",
        "blocked_until_p0_ready_and_runtime_proven"
      ],
      "properties": {
        "scorecard_alone_allows_completion_claim": { "const": false },
        "product_specific_production_claim_allowed": { "const": false },
        "blocked_until_p0_ready_and_runtime_proven": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "public_private_boundary": {
      "type": "object",
      "required": [
        "public_safe_refs_only",
        "raw_private_evidence_embedded",
        "private_context_retained_outside_public_repo"
      ],
      "properties": {
        "public_safe_refs_only": { "const": true },
        "raw_private_evidence_embedded": { "const": false },
        "private_context_retained_outside_public_repo": { "const": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
