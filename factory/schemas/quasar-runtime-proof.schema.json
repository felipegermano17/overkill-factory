{
  "$id": "https://overkill-factory.dev/schemas/quasar-runtime-proof.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "result",
    "proof_kind",
    "install_source",
    "source_ref",
    "source_head_expected",
    "source_head",
    "source_head_matches",
    "container_image",
    "solana_release",
    "solana_install_url",
    "policy_decision"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "proof_kind": {
      "type": "string",
      "minLength": 1
    },
    "install_source": {
      "type": "string",
      "minLength": 1
    },
    "source_head": {
      "type": "string"
    },
    "source_ref": {
      "type": "string",
      "minLength": 7
    },
    "source_head_expected": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_head_matches": {
      "type": "boolean"
    },
    "container_image": {
      "type": "string",
      "pattern": "@sha256:[0-9a-f]{64}$"
    },
    "solana_release": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+([-._a-zA-Z0-9]+)?$"
    },
    "solana_install_url": {
      "type": "string",
      "pattern": "^https://release\\.anza\\.xyz/v[0-9]+\\.[0-9]+\\.[0-9]+([-._a-zA-Z0-9]+)?/install$"
    },
    "build_status": {
      "type": "string"
    },
    "test_status": {
      "type": "string"
    },
    "policy_decision": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "source_head_matches": {
            "const": true
          },
          "source_head": {
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
