{
  "$schema": "https://overkill-factory.dev/schemas/factory-security-excellence-registry.schema.json",
  "record_type": "factory_security_excellence_registry",
  "registry_id": "factory-security-excellence-v1",
  "purpose": "Define the Overkill Factory security excellence bar so product creation is secure-by-design, architecture-first, evidence-gated and culturally fail-closed across all demand types.",
  "security_culture_policy": {
    "security_is_culture_not_checklist": true,
    "security_before_implementation": true,
    "architecture_first_for_greenfield": true,
    "applies_to_all_change_types": true,
    "fail_closed_on_missing_security_evidence": true,
    "forbid_unqualified_perfection_claims": true,
    "allowed_security_claim_language": "best possible with evidence, gates and explicit residual-risk ownership",
    "residual_risk_record_required": true
  },
  "pillar_coverage": [
    {
      "pillar_key": "secure_by_design_culture",
      "display_name": "Secure-by-Design Culture",
      "security_goal": "Make security a default product culture and authority model, not a late review checklist.",
      "coverage_status": "partial",
      "existing_controls": [
        "security-profile",
        "worker permission classes",
        "risk gates",
        "human gates"
      ],
      "required_artifacts": [
        "security culture policy",
        "method contract security posture",
        "residual risk record"
      ],
      "required_workers": [
        "security-orchestrator"
      ],
      "required_gates": [
        "method contract gate",
        "risk gate"
      ],
      "required_evidence": [
        "security policy in method contract",
        "residual risk record"
      ],
      "gap_or_upgrade": "Make culture policy explicit across every product/change type.",
      "risk_if_missing": "Security becomes a final checklist and product teams build unsafe defaults.",
      "applies_when": [
        "all factory work"
      ],
      "shape": "culture_policy"
    },
    {
