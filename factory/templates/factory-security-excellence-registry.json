  "greenfield_security_policy": {
    "secure_architecture_before_build": true,
    "threat_model_before_build": true,
    "trust_boundaries_before_build": true,
    "privacy_before_data": true,
    "secrets_before_integration": true,
    "observability_before_release": true
  },
  "change_security_policy": {
    "bug_fixes_can_trigger_security_review": true,
    "refactors_can_trigger_security_review": true,
    "dependency_changes_trigger_supply_chain_review": true,
    "ai_or_agent_changes_trigger_ai_security_review": true,
    "solana_changes_trigger_solana_ai_kit": true
  },
  "non_goals": [
    "do not claim perfect security",
    "do not treat security as late checklist",
    "do not skip threat modeling for greenfield architecture",
    "do not route Solana/onchain outside Solana AI Kit",
    "do not publish private security evidence"
  ]
