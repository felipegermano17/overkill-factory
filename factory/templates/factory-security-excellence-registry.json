      "gap_or_upgrade": "Current template exists but needs stronger secure-by-default architecture packet.",
      "risk_if_missing": "Greenfield products can bake in weak trust boundaries that are expensive to fix.",
      "applies_when": [
        "new product",
        "material feature",
        "integration",
        "production change"
