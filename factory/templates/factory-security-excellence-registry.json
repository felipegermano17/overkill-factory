        "trust boundary map",
        "data-flow diagram",
        "security owner record"
      ],
      "required_workers": [
        "security-orchestrator",
        "product-architect"
      ],
      "required_gates": [
        "before implementation gate",
        "human gate when R3/R4"
      ],
      "required_evidence": [
        "architecture packet",
        "gate verdict",
        "owner assignment"
