{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/overkill_factory_bridge_hook.py\" --inbox-dir \"$(git rev-parse --show-toplevel)/.tmp/factory-runs/operator-inbox\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/overkill_factory_bridge_hook.py\" --inbox-dir \"$(git rev-parse --show-toplevel)/.tmp/factory-runs/operator-inbox\"",
            "timeout": 30,
            "statusMessage": "Reading Overkill Factory bridge inbox"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/overkill_factory_bridge_hook.py\" --inbox-dir \"$(git rev-parse --show-toplevel)/.tmp/factory-runs/operator-inbox\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/overkill_factory_bridge_hook.py\" --inbox-dir \"$(git rev-parse --show-toplevel)/.tmp/factory-runs/operator-inbox\"",
            "timeout": 30,
            "statusMessage": "Classifying Overkill Factory bridge prompt"
          }
        ]
      }
    ]
  }
}
