  "cards": [
    {
      "dot": "emerald",
      "title": "Fase boa",
      "items": [
        "Recebe entrada verificável",
        "Produz delta de produto",
        "Destrava próxima fase"
      ]
    },
    {
      "dot": "rose",
      "title": "Fase ruim",
      "items": [
        "Gera documento sem melhorar produto",
        "Aceita process_pass como done",
        "Esconde blocker até o usuário perguntar"
      ]
    },
    {
      "dot": "amber",
      "title": "Engrenagem perfeita",
      "items": [
        "Falha vira reparo tipado",
        "Gate humano é raro e explícito",
        "Loop repetido falha alto"
      ]
    }
  ]
