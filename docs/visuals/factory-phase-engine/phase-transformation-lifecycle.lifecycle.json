      "col": 0,
      "step": "01",
      "tag": "ready"
    },
    {
      "id": "transform",
      "type": "active",
      "label": "Transformar",
      "sublabel": "melhora produto",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "delta"
    },
    {
      "id": "submitted",
      "type": "active",
      "label": "Submitted",
      "sublabel": "worker declarou",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "não é done"
    },
    {
      "id": "readback",
      "type": "decision",
      "label": "Readback",
      "sublabel": "artifact real",
      "lane": "main",
      "col": 3,
      "step": "04",
      "tag": "verdade"
    },
    {
      "id": "quality",
      "type": "decision",
      "label": "Qualidade",
      "sublabel": "serve downstream",
      "lane": "main",
      "col": 4,
      "step": "05",
      "tag": "excelência"
    },
    {
      "id": "repair",
      "type": "waiting",
      "label": "Reparo",
      "sublabel": "factory-owned",
      "lane": "events",
      "col": 0,
      "tag": "interno"
    },
    {
      "id": "human",
      "type": "waiting",
      "label": "Gate humano",
      "sublabel": "autoridade real",
      "lane": "events",
      "col": 1,
      "tag": "raro"
    },
    {
      "id": "skip",
      "type": "waiting",
      "label": "Skip",
      "sublabel": "não se aplica",
      "lane": "events",
      "col": 2,
      "tag": "explícito"
    },
    {
      "id": "done",
      "type": "success",
      "label": "Done",
