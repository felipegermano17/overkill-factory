      "sublabel": "humano/externo",
      "lane": "terminal",
      "col": 1,
      "tag": "honesto"
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "Loop fail",
      "sublabel": "sem progresso",
      "lane": "terminal",
      "col": 2,
      "tag": "fail loud"
    }
