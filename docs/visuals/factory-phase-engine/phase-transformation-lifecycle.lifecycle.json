    },
    {
      "from": "skip",
      "to": "done",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight"
    },
    {
      "from": "quality",
      "to": "done",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop"
    },
    {
      "from": "repair",
      "to": "failed",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight"
