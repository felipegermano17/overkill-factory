{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overkill-factory.dev/schemas/factory-doctor-result.schema.json",
  "title": "Overkill Factory Doctor Result",
  "type": "object",
  "required": [
    "$schema",
    "record_type",
    "created_at",
    "result",
    "factory_version",
    "checks",
    "next_step"
  ],
  "properties": {
    "$schema": { "const": "https://overkill-factory.dev/schemas/factory-doctor-result.schema.json" },
    "record_type": { "const": "factory_doctor_result" },
    "created_at": { "type": "string", "minLength": 10 },
    "result": { "enum": ["PASS", "WARN", "FAIL"] },
    "factory_version": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "status": { "enum": ["PASS", "WARN", "FAIL", "INFO"] },
          "summary": { "type": "string", "minLength": 3 },
          "detail": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "next_step": { "type": "string", "minLength": 8 }
  },
  "additionalProperties": false
}
