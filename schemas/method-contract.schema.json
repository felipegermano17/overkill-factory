{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overkill-factory.dev/schemas/method-contract.schema.json",
  "title": "Overkill Factory Method Contract",
  "type": "object",
  "required": [
    "record_type",
    "contract_id",
    "created_at",
    "factory_method_version",
    "full_product_sot_scope_coverage_ref",
    "selected_method",
    "why_this_method",
    "risk_tier",
    "required_plans",
    "required_gates",
    "waivers",
    "canonical_scope_source",
    "scope_intent",
    "factory_route",
    "required_factory_artifacts",
    "engineering_method_matrix",
    "slice_execution_policy",
    "production_route_decision",
    "work_type",
    "selected_methods",
    "skipped_methods",
    "required_artifacts",
    "required_workers",
    "reviewers",
    "evidence_requirements",
    "authority_limit",
    "done_criteria",
    "blocking_rules",
    "handoff",
    "public_private_boundary",
    "acceptance"
  ],
  "properties": {
    "$schema": { "const": "https://overkill-factory.dev/schemas/method-contract.schema.json" },
    "record_type": { "const": "method_contract" },
    "contract_id": { "type": "string", "minLength": 3 },
    "created_at": { "type": "string", "minLength": 10 },
    "factory_method_version": { "const": "OVERKILL_VFINAL" },
    "full_product_sot_scope_coverage_ref": { "type": "string", "minLength": 3 },
    "selected_method": {
      "type": "string",
      "minLength": 3
    },
    "why_this_method": {
      "type": "string",
      "minLength": 3
    },
    "risk_tier": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "required_plans": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "canonical_scope_source": {
      "type": "string",
      "minLength": 3
    },
    "scope_intent": {
      "enum": [
        "full_product",
        "child_slice",
        "bug",
        "release",
        "incident",
        "doc",
        "migration",
        "integration"
      ]
    },
    "factory_route": {
      "type": "string",
      "minLength": 3
    },
    "required_factory_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "engineering_method_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "surface_or_component",
          "methods",
          "reason",
          "required_artifacts",
          "evidence_required"
        ],
        "properties": {
          "surface_or_component": { "type": "string", "minLength": 3 },
          "methods": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
          "reason": { "type": "string", "minLength": 3 },
          "required_artifacts": { "type": "array", "items": { "type": "string" } },
          "evidence_required": { "type": "array", "items": { "type": "string" } },
          "skipped_methods": { "type": "array", "items": { "type": "object" } }
        },
        "additionalProperties": true
      }
    },
    "slice_execution_policy": {
      "type": "object",
      "required": [
        "slices_are_execution_units_only",
        "canonical_scope_must_not_shrink"
      ],
      "properties": {
        "slices_are_execution_units_only": { "const": true },
        "canonical_scope_must_not_shrink": { "const": true },
        "first_slice_completion_is_not_product_completion": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "production_route_decision": {
      "type": "string",
      "minLength": 3
    },
    "research_decision_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "research_route_impacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "work_type": {
      "type": "string",
      "minLength": 3
    },
    "selected_methods": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "skipped_methods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "method",
          "reason"
        ],
        "properties": {
          "method": {
            "type": "string",
            "minLength": 2
          },
          "reason": {
            "type": "string",
            "minLength": 3
          }
        },
        "additionalProperties": true
      }
    },
    "required_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "required_workers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "authority_limit": {
      "type": "string",
      "minLength": 3
    },
    "done_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "blocking_rules": {
      "type": "object",
      "required": [
        "full_scope_coverage_required",
        "product_creation_plan_required",
        "execution_blocked_until_ready_gate",
        "raw_private_evidence_must_stay_external",
        "operator_must_not_choose_internal_method"
      ],
      "properties": {
        "full_scope_coverage_required": { "const": true },
        "product_creation_plan_required": { "const": true },
        "execution_blocked_until_ready_gate": { "const": true },
        "raw_private_evidence_must_stay_external": { "const": true },
        "operator_must_not_choose_internal_method": { "const": true }
      },
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "required": [
        "next_artifact",
        "next_worker",
        "next_safe_action",
        "user_decision_required",
        "factory_owned_next_step"
      ],
      "properties": {
        "next_artifact": { "type": "string", "minLength": 3 },
        "next_worker": { "type": "string", "minLength": 3 },
        "next_safe_action": { "type": "string", "minLength": 6 },
        "user_decision_required": { "type": "boolean" },
        "factory_owned_next_step": { "const": true }
      },
      "additionalProperties": false
    },
    "public_private_boundary": {
      "type": "object",
      "required": [
        "public_safe_refs_only",
        "raw_private_evidence_embedded",
        "private_context_retained_outside_public_repo"
      ],
      "properties": {
        "public_safe_refs_only": { "const": true },
        "raw_private_evidence_embedded": { "const": false },
        "private_context_retained_outside_public_repo": { "const": true }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "required": [
        "method_contract_created",
        "execution_allowed",
        "selected_method_is_factory_owned",
        "scope_reduction_detected",
        "blocked_reason",
        "evidence_refs"
      ],
      "properties": {
        "method_contract_created": { "const": true },
        "execution_allowed": { "const": false },
        "selected_method_is_factory_owned": { "const": true },
        "scope_reduction_detected": { "const": false },
        "blocked_reason": { "type": "string", "minLength": 6 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
