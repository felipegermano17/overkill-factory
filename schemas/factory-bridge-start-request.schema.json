{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overkill-factory.dev/schemas/factory-bridge-start-request.schema.json",
  "title": "Overkill Factory Bridge Start Request",
  "type": "object",
  "required": [
    "$schema",
    "record_type",
    "run_id",
    "operator_goal",
    "project_mode",
    "created_by",
    "created_at",
    "source_envelope_ref",
    "run_record_ref",
    "handoff_to_factory",
    "target_board_policy",
    "bridge_limits",
    "requested_factory_action",
    "authority"
  ],
  "properties": {
    "$schema": {
      "const": "https://overkill-factory.dev/schemas/factory-bridge-start-request.schema.json"
    },
    "record_type": { "const": "factory_bridge_start_request" },
    "run_id": { "type": "string", "minLength": 3 },
    "operator_goal": { "type": "string", "minLength": 3 },
    "project_mode": {
      "type": "string",
      "enum": ["new_project", "existing_project"]
    },
    "created_by": { "type": "string", "minLength": 2 },
    "created_at": { "type": "string", "minLength": 10 },
    "source_envelope_ref": { "type": "string", "minLength": 3 },
    "run_record_ref": { "type": "string", "minLength": 3 },
    "operator_language_policy": {
      "type": "object",
      "required": [
        "primary_language",
        "user_facing_surfaces_follow_primary_language",
        "kanban_cards_follow_primary_language",
        "decision_packages_follow_primary_language",
        "internal_factory_surfaces_may_use_english"
      ],
      "properties": {
        "primary_language": { "type": "string", "minLength": 2 },
        "user_facing_surfaces_follow_primary_language": { "const": true },
        "kanban_cards_follow_primary_language": { "const": true },
        "decision_packages_follow_primary_language": { "const": true },
        "internal_factory_surfaces_may_use_english": { "const": true }
      },
      "additionalProperties": true
    },
    "handoff_to_factory": {
      "type": "object",
      "required": [
        "gateway_profile",
        "orchestrator_worker",
        "handoff_contract",
        "bridge_may_execute_recipient_work",
        "bridge_may_create_hermes_board",
        "factory_start_path_required"
      ],
      "properties": {
        "gateway_profile": { "const": "overkill-factory-gerente" },
        "orchestrator_worker": { "const": "factory-orchestrator" },
        "handoff_contract": { "const": "factory_bridge_start_request" },
        "bridge_may_execute_recipient_work": { "const": false },
        "bridge_may_create_hermes_board": { "const": false },
        "factory_start_path_required": { "const": true }
      },
      "additionalProperties": false
    },
    "target_board_policy": {
      "type": "object",
      "required": [
        "policy",
        "requires_new_hermes_board",
        "existing_board_ref",
        "requires_explicit_existing_board_ref",
        "board_creation_owner",
        "factory_start_path_required",
        "bridge_may_select_existing_board",
        "bridge_may_mutate_board"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "enum": ["factory_must_create_new_board", "use_explicit_existing_board"]
        },
        "requires_new_hermes_board": { "type": "boolean" },
        "existing_board_ref": { "type": ["string", "null"] },
        "requires_explicit_existing_board_ref": { "type": "boolean" },
        "board_creation_owner": {
          "type": "string",
          "enum": ["factory_start_path", "existing_runtime"]
        },
        "factory_start_path_required": { "const": true },
        "bridge_may_select_existing_board": { "const": false },
        "bridge_may_mutate_board": { "const": false }
      },
      "additionalProperties": false
    },
    "bridge_limits": {
      "type": "object",
      "required": [
        "bridge_must_not_create_hermes_board",
        "bridge_must_not_create_hermes_cards",
        "bridge_must_not_dispatch_workers",
        "bridge_must_not_choose_runtime_board",
        "bridge_only_registers_operator_intent"
      ],
      "properties": {
        "bridge_must_not_create_hermes_board": { "const": true },
        "bridge_must_not_create_hermes_cards": { "const": true },
        "bridge_must_not_dispatch_workers": { "const": true },
        "bridge_must_not_choose_runtime_board": { "const": true },
        "bridge_only_registers_operator_intent": { "const": true }
      },
      "additionalProperties": false
    },
    "requested_factory_action": {
      "type": "object",
      "required": [
        "action",
        "owner",
        "gateway_profile",
        "factory_must_materialize_runtime_state"
      ],
      "properties": {
        "action": { "const": "start_factory_run" },
        "owner": { "const": "factory-orchestrator" },
        "gateway_profile": { "const": "overkill-factory-gerente" },
        "factory_must_materialize_runtime_state": { "const": true }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": [
        "can_close_gate",
        "can_execute_factory_work",
        "can_auto_approve_human_gate",
        "can_mutate_hermes_state"
      ],
      "properties": {
        "can_close_gate": { "const": false },
        "can_execute_factory_work": { "const": false },
        "can_auto_approve_human_gate": { "const": false },
        "can_mutate_hermes_state": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "project_mode": { "const": "new_project" }
        }
      },
      "then": {
        "properties": {
          "target_board_policy": {
            "properties": {
              "policy": { "const": "factory_must_create_new_board" },
              "requires_new_hermes_board": { "const": true },
              "existing_board_ref": { "const": null },
              "requires_explicit_existing_board_ref": { "const": false },
              "board_creation_owner": { "const": "factory_start_path" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "project_mode": { "const": "existing_project" }
        }
      },
      "then": {
        "properties": {
          "target_board_policy": {
            "properties": {
              "policy": { "const": "use_explicit_existing_board" },
              "requires_new_hermes_board": { "const": false },
              "existing_board_ref": { "type": "string", "minLength": 3 },
              "requires_explicit_existing_board_ref": { "const": true },
              "board_creation_owner": { "const": "existing_runtime" }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
