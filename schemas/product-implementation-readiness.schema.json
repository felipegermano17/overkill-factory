{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overkill-factory.dev/schemas/product-implementation-readiness.schema.json",
  "title": "Overkill Factory Product Implementation Readiness",
  "type": "object",
  "required": [
    "record_type",
    "readiness_id",
    "created_at",
    "factory_method_version",
    "product_sot_ref",
    "method_contract_ref",
    "product_creation_plan_ref",
    "decomposition_coverage_review_ref",
    "decomposition_coverage_review_result",
    "product_delivery_quality_profile_trace",
    "artifact_alignment_result",
    "requirements_trace",
    "cross_slice_decision_coverage",
    "proof_coverage",
    "ready_work_units",
    "blocked_work_units",
    "allowed_next_actions",
    "forbidden_next_actions",
    "blocking_rules",
    "handoff",
    "public_private_boundary",
    "acceptance",
    "evidence_refs"
  ],
  "properties": {
    "$schema": { "const": "https://overkill-factory.dev/schemas/product-implementation-readiness.schema.json" },
    "record_type": { "const": "product_implementation_readiness" },
    "readiness_id": { "type": "string", "minLength": 3 },
    "created_at": { "type": "string", "minLength": 10 },
    "factory_method_version": { "const": "OVERKILL_VFINAL" },
    "product_sot_ref": { "type": "string", "minLength": 3 },
    "method_contract_ref": { "type": "string", "minLength": 3 },
    "product_creation_plan_ref": { "type": "string", "minLength": 3 },
    "decomposition_coverage_review_ref": { "type": "string", "minLength": 3 },
    "decomposition_coverage_review_result": { "const": "PASS" },
    "product_delivery_quality_profile_ref": { "type": "string", "minLength": 3 },
    "product_delivery_quality_profile_trace": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "delivery_profile_proof_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["proof_id", "status", "evidence_refs"],
        "properties": {
          "proof_id": { "type": "string", "minLength": 3 },
          "status": { "enum": ["PASS", "WARN", "FAIL", "WAIVED"] },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "owner": { "type": "string" },
          "reviewer": { "type": "string" },
          "basis": { "type": "string" },
          "waiver_owner": { "type": "string" },
          "waiver_reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "artifact_alignment_result": { "enum": ["PASS", "CONCERNS", "FAIL", "BLOCKED"] },
    "concern_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "concern_id",
          "severity",
          "owner",
          "impact",
          "allowed_actions",
          "forbidden_actions",
          "allowed_ready_work_units",
          "expiry",
          "next_action",
          "evidence_refs"
        ],
        "properties": {
          "concern_id": { "type": "string", "minLength": 3 },
          "severity": { "enum": ["LOW", "MEDIUM", "HIGH", "BLOCKING"] },
          "owner": { "type": "string", "minLength": 3 },
          "impact": { "type": "string", "minLength": 3 },
          "allowed_actions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "forbidden_actions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "allowed_ready_work_units": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "expiry": { "type": "string", "minLength": 3 },
          "next_action": { "type": "string", "minLength": 3 },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          }
        },
        "additionalProperties": true
      }
    },
    "requirements_trace": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "cross_slice_decision_coverage": { "type": "array", "items": { "type": "string" } },
    "experience_trace": { "type": "array", "items": { "type": "string" } },
    "security_trace": { "type": "array", "items": { "type": "string" } },
    "capability_pack_trace": { "type": "array", "items": { "type": "string" } },
    "access_and_secret_trace": { "type": "array", "items": { "type": "string" } },
    "proof_coverage": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "stale_artifacts": { "type": "array", "items": { "type": "string" } },
    "contradictions": { "type": "array", "items": { "type": "string" } },
    "ready_work_units": { "type": "array", "items": { "type": "string" } },
    "blocked_work_units": { "type": "array", "items": { "type": "string" } },
    "human_decisions_required": { "type": "array", "items": { "type": "string" } },
    "allowed_next_actions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "forbidden_next_actions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "blocking_rules": {
      "type": "object",
      "required": [
        "product_creation_plan_required",
        "decomposition_coverage_review_required",
        "blocked_or_failed_decomposition_review_blocks_execution",
        "blocked_or_failed_readiness_blocks_execution",
        "concerns_allow_only_ready_work_units",
        "complete_product_claim_forbidden_until_all_scope_reconciled",
        "raw_private_evidence_must_stay_external"
      ],
      "properties": {
        "product_creation_plan_required": { "const": true },
        "decomposition_coverage_review_required": { "const": true },
        "blocked_or_failed_decomposition_review_blocks_execution": { "const": true },
        "blocked_or_failed_readiness_blocks_execution": { "const": true },
        "concerns_allow_only_ready_work_units": { "const": true },
        "complete_product_claim_forbidden_until_all_scope_reconciled": { "const": true },
        "raw_private_evidence_must_stay_external": { "const": true }
      },
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "required": [
        "next_artifact",
        "next_worker",
        "next_safe_action",
        "user_decision_required",
        "factory_owned_next_step"
      ],
      "properties": {
        "next_artifact": { "type": "string", "minLength": 3 },
        "next_worker": { "type": "string", "minLength": 3 },
        "next_safe_action": { "type": "string", "minLength": 6 },
        "user_decision_required": { "type": "boolean" },
        "factory_owned_next_step": { "const": true }
      },
      "additionalProperties": false
    },
    "public_private_boundary": {
      "type": "object",
      "required": [
        "public_safe_refs_only",
        "raw_private_evidence_embedded",
        "private_context_retained_outside_public_repo"
      ],
      "properties": {
        "public_safe_refs_only": { "const": true },
        "raw_private_evidence_embedded": { "const": false },
        "private_context_retained_outside_public_repo": { "const": true }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "required": [
        "product_implementation_readiness_created",
        "material_execution_allowed",
        "allowed_execution_scope",
        "complete_product_claim_allowed",
        "evidence_refs"
      ],
      "properties": {
        "product_implementation_readiness_created": { "const": true },
        "material_execution_allowed": { "type": "boolean" },
        "allowed_execution_scope": { "enum": ["none", "ready_work_units_only", "all_ready_work_units"] },
        "complete_product_claim_allowed": { "const": false },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        }
      },
      "additionalProperties": false
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact_alignment_result": { "const": "CONCERNS" }
        },
        "required": ["artifact_alignment_result"]
      },
      "then": {
        "required": ["concern_items"],
        "properties": {
          "concern_items": { "minItems": 1 }
        }
      }
    }
  ],
  "additionalProperties": true
}
