{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overkill-factory.dev/schemas/product-implementation-readiness.schema.json",
  "title": "Overkill Factory Product Implementation Readiness",
  "type": "object",
  "required": [
    "record_type",
    "product_sot_ref",
    "method_contract_ref",
    "product_creation_plan_ref",
    "product_delivery_quality_profile_trace",
    "artifact_alignment_result",
    "requirements_trace",
    "cross_slice_decision_coverage",
    "proof_coverage",
    "ready_work_units",
    "blocked_work_units",
    "allowed_next_actions",
    "forbidden_next_actions",
    "evidence_refs"
  ],
  "properties": {
    "$schema": { "const": "https://overkill-factory.dev/schemas/product-implementation-readiness.schema.json" },
    "record_type": { "const": "product_implementation_readiness" },
    "product_sot_ref": { "type": "string", "minLength": 3 },
    "method_contract_ref": { "type": "string", "minLength": 3 },
    "product_creation_plan_ref": { "type": "string", "minLength": 3 },
    "product_delivery_quality_profile_ref": { "type": "string", "minLength": 3 },
    "product_delivery_quality_profile_trace": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "delivery_profile_proof_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["proof_id", "status", "evidence_refs"],
        "properties": {
          "proof_id": { "type": "string", "minLength": 3 },
          "status": { "enum": ["PASS", "WARN", "FAIL", "WAIVED"] },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "owner": { "type": "string" },
          "reviewer": { "type": "string" },
          "basis": { "type": "string" },
          "waiver_owner": { "type": "string" },
          "waiver_reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "artifact_alignment_result": { "enum": ["PASS", "CONCERNS", "FAIL", "BLOCKED"] },
    "concern_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "concern_id",
          "severity",
          "owner",
          "impact",
          "allowed_actions",
          "forbidden_actions",
          "allowed_ready_work_units",
          "expiry",
          "next_action",
          "evidence_refs"
        ],
        "properties": {
          "concern_id": { "type": "string", "minLength": 3 },
          "severity": { "enum": ["LOW", "MEDIUM", "HIGH", "BLOCKING"] },
          "owner": { "type": "string", "minLength": 3 },
          "impact": { "type": "string", "minLength": 3 },
          "allowed_actions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "forbidden_actions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "allowed_ready_work_units": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "expiry": { "type": "string", "minLength": 3 },
          "next_action": { "type": "string", "minLength": 3 },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          }
        },
        "additionalProperties": true
      }
    },
    "requirements_trace": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "cross_slice_decision_coverage": { "type": "array", "items": { "type": "string" } },
    "experience_trace": { "type": "array", "items": { "type": "string" } },
    "security_trace": { "type": "array", "items": { "type": "string" } },
    "capability_pack_trace": { "type": "array", "items": { "type": "string" } },
    "access_and_secret_trace": { "type": "array", "items": { "type": "string" } },
    "proof_coverage": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "stale_artifacts": { "type": "array", "items": { "type": "string" } },
    "contradictions": { "type": "array", "items": { "type": "string" } },
    "ready_work_units": { "type": "array", "items": { "type": "string" } },
    "blocked_work_units": { "type": "array", "items": { "type": "string" } },
    "human_decisions_required": { "type": "array", "items": { "type": "string" } },
    "allowed_next_actions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "forbidden_next_actions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact_alignment_result": { "const": "CONCERNS" }
        },
        "required": ["artifact_alignment_result"]
      },
      "then": {
        "required": ["concern_items"],
        "properties": {
          "concern_items": { "minItems": 1 }
        }
      }
    }
  ],
  "additionalProperties": true
}
