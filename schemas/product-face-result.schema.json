{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overkill-factory.dev/schemas/product-face-result.schema.json",
  "title": "Overkill Factory Product Face Result",
  "type": "object",
  "required": [
    "result",
    "tool_or_profile",
    "executed_by",
    "screenshots",
    "viewports",
    "checked_states",
    "user_journeys_checked",
    "a11y",
    "overlap_check",
    "performance_note",
    "packet_comparison",
    "source_promise_coverage",
    "design_fit_review",
    "professional_design_process_ref",
    "professional_design_process_comparison",
    "reference_quality_comparison",
    "visual_quality_result",
    "blocking_findings",
    "evidence_refs",
    "evidence_kind",
    "reusable_for_product",
    "next_action"
  ],
  "properties": {
    "result": {
      "enum": ["PASS", "WAIVED"]
    },
    "tool_or_profile": {
      "type": "string",
      "minLength": 3
    },
    "executed_by": {
      "type": "string",
      "minLength": 3
    },
    "screenshots": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "checked_states": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "user_journeys_checked": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "a11y": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pass", "warn", "fail"] }
      },
      "additionalProperties": true
    },
    "overlap_check": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pass", "warn", "fail"] }
      },
      "additionalProperties": true
    },
    "console": {
      "type": "object",
      "properties": {
        "status": { "enum": ["pass", "warn", "fail"] }
      },
      "additionalProperties": true
    },
    "performance_note": {
      "type": "string",
      "minLength": 3
    },
    "packet_ref": {
      "type": "string"
    },
    "packet_comparison": {
      "type": "object",
      "required": ["status", "basis"],
      "properties": {
        "status": { "enum": ["pass", "warn", "fail", "pending"] },
        "basis": { "type": "string", "minLength": 3 }
      },
      "additionalProperties": true
    },
    "source_promise_coverage": {
      "type": "object",
      "required": ["status", "basis"],
      "properties": {
        "status": { "enum": ["pass", "warn", "fail", "pending"] },
        "basis": { "type": "string", "minLength": 3 }
      },
      "additionalProperties": true
    },
    "design_fit_review": {
      "type": "object",
      "required": ["status", "basis"],
      "properties": {
        "status": { "enum": ["pass", "warn", "fail", "pending"] },
        "basis": { "type": "string", "minLength": 3 }
      },
      "additionalProperties": true
    },
    "professional_design_process_ref": {
      "type": "string"
    },
    "professional_design_process_comparison": {
      "type": "object",
      "required": ["status", "basis"],
      "properties": {
        "status": { "enum": ["pass", "warn", "fail", "pending"] },
        "basis": { "type": "string", "minLength": 3 }
      },
      "additionalProperties": true
    },
    "reference_quality_comparison": {
      "type": "object",
      "required": [
        "status",
        "basis",
        "reference_set_ref",
        "compared_source_ids",
        "dimensions",
        "reviewer_independent_from_implementation"
      ],
      "properties": {
        "status": { "enum": ["pass", "warn", "fail", "pending"] },
        "basis": { "type": "string", "minLength": 3 },
        "reference_set_ref": { "type": "string", "minLength": 3 },
        "compared_source_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "reviewer_independent_from_implementation": { "type": "boolean" },
        "dimensions": {
          "type": "object",
          "required": [
            "layout_hierarchy",
            "interaction_model",
            "state_coverage",
            "visual_language",
            "density_spacing"
          ],
          "properties": {
            "layout_hierarchy": { "$ref": "#/$defs/reference_dimension_verdict" },
            "interaction_model": { "$ref": "#/$defs/reference_dimension_verdict" },
            "state_coverage": { "$ref": "#/$defs/reference_dimension_verdict" },
            "visual_language": { "$ref": "#/$defs/reference_dimension_verdict" },
            "density_spacing": { "$ref": "#/$defs/reference_dimension_verdict" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "visual_quality_result": {
      "type": "object",
      "required": ["status", "reviewer", "basis", "reference_quality_bar_checked", "ai_generic_symptoms"],
      "properties": {
        "status": { "enum": ["PASS", "BLOCK", "PASS_WITH_RESIDUALS"] },
        "reviewer": { "type": "string", "minLength": 3 },
        "basis": { "type": "string", "minLength": 3 },
        "reference_quality_bar_checked": { "type": "boolean" },
        "ai_generic_symptoms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "residuals": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "domain_proof_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["proof_id", "status", "evidence_refs", "basis"],
        "properties": {
          "proof_id": { "type": "string", "minLength": 3 },
          "status": { "enum": ["PASS", "WARN", "FAIL", "WAIVED"] },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "reviewer": { "type": "string" },
          "basis": { "type": "string", "minLength": 3 },
          "waiver_owner": { "type": "string" },
          "waiver_reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "blocking_findings": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_kind": {
      "enum": ["real", "synthetic", "waiver"]
    },
    "reusable_for_product": {
      "type": "boolean"
    },
    "next_action": {
      "type": "string"
    }
  },
  "$defs": {
    "reference_dimension_verdict": {
      "type": "object",
      "required": ["status", "basis"],
      "properties": {
        "status": { "enum": ["pass", "warn", "fail", "pending"] },
        "basis": { "type": "string", "minLength": 3 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
