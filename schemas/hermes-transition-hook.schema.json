{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overkill-factory.dev/schemas/hermes-transition-hook.schema.json",
  "title": "Overkill Factory Hermes Transition Hook Result",
  "type": "object",
  "required": [
    "hook_type",
    "transition_action",
    "blocked_reasons",
    "plan",
    "ledger"
  ],
  "properties": {
    "hook_type": {
      "const": "overkill_factory_hermes_transition_hook"
    },
    "transition_action": {
      "enum": [
        "allow",
        "allow_and_create_worker_tasks",
        "allow_done",
        "allow_review_ready",
        "block_and_create_before_ready_tasks",
        "block_transition"
      ]
    },
    "blocked_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "completion_reconciliation": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "review_task_authorizations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "authorization_type",
          "authorization_state",
          "requirement_id",
          "producer_field",
          "authorized_worker_id",
          "authorized_scope",
          "runtime_authority",
          "local_state_authority"
        ],
        "properties": {
          "authorization_type": { "const": "review_task_only" },
          "authorization_state": { "const": "review_task_ready" },
          "authorized_scope": {
            "type": "array",
            "contains": { "const": "review" }
          },
          "runtime_authority": { "const": "hermes_kanban" },
          "local_state_authority": { "const": false }
        },
        "additionalProperties": true
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "plan_type",
        "event",
        "transition_action",
        "blocked_reasons",
        "gate_report",
        "worker_tasks"
      ],
      "additionalProperties": true
    },
    "ledger": {
      "type": "object",
      "required": [
        "ledger_path",
        "created",
        "updated",
        "unchanged",
        "task_count"
      ],
      "properties": {
        "created": {
          "type": "array",
          "items": { "type": "string" }
        },
        "updated": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unchanged": {
          "type": "array",
          "items": { "type": "string" }
        },
        "task_count": { "type": "integer" },
        "review_task_authorization_count": { "type": "integer" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
