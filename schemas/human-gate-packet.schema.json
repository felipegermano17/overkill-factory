{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overkill-factory.dev/schemas/human-gate-packet.schema.json",
  "title": "Overkill Factory Human Gate Packet",
  "type": "object",
  "properties": {
    "gate_type": { "type": "string", "minLength": 3 },
    "required_approvers": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 }
    },
    "decision_state": { "type": "string", "minLength": 3 },
    "risk_owner": { "type": "string", "minLength": 2 },
    "security_owner": { "type": "string", "minLength": 2 },
    "rollback_owner": { "type": "string", "minLength": 2 },
    "waiver_policy": { "type": "string", "minLength": 3 },
    "operator_briefing_package_ref": { "type": "string", "minLength": 3 },
    "approval_request_ref": { "type": "string", "minLength": 3 },
    "evidence_index_ref": { "type": "string", "minLength": 3 },
    "owner_review_ref": { "type": "string", "minLength": 3 },
    "required_decision_assets": {
      "type": "array",
      "items": {
        "enum": [
          "markdown_document",
          "pdf_document",
          "approval_request_json",
          "evidence_index_json",
          "owner_review_markdown"
        ]
      }
    },
    "optional_explainer_assets": {
      "type": "array",
      "items": {
        "enum": [
          "diagram",
          "video_explainer",
          "animation_html",
          "audio_explainer"
        ]
      }
    },
    "decision_package_delivery": {
      "type": "object",
      "properties": {
        "operator_interface": {
          "enum": ["telegram", "discord", "cockpit", "codex_bridge", "cli", "api"]
        },
        "push_required": { "type": "boolean" },
        "summary_only_forbidden": { "type": "boolean" },
        "material_before_question": { "type": "boolean" },
        "attachment_order": {
          "type": "array",
          "items": { "type": "string", "minLength": 3 }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
