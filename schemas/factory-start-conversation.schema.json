{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overkill-factory.dev/schemas/factory-start-conversation.schema.json",
  "title": "Overkill Factory Start Conversation",
  "type": "object",
  "required": [
    "$schema",
    "record_type",
    "conversation_id",
    "created_at",
    "primary_interface_ref",
    "primary_interface",
    "source_envelope_ref",
    "start_mode",
    "conversation_state",
    "product_understanding_loop",
    "factory_start_boundary",
    "handoff",
    "public_private_boundary",
    "acceptance"
  ],
  "properties": {
    "$schema": { "const": "https://overkill-factory.dev/schemas/factory-start-conversation.schema.json" },
    "record_type": { "const": "factory_start_conversation" },
    "conversation_id": { "type": "string", "minLength": 3 },
    "created_at": { "type": "string", "minLength": 10 },
    "primary_interface_ref": { "type": "string", "minLength": 3 },
    "primary_interface": { "enum": ["telegram", "discord", "cockpit", "codex_bridge", "cli", "api"] },
    "source_envelope_ref": { "type": "string", "minLength": 3 },
    "start_mode": { "const": "conversational_intake_before_factory_start" },
    "conversation_state": {
      "type": "object",
      "required": ["status", "rounds_completed", "open_questions", "max_questions_next_turn"],
      "properties": {
        "status": {
          "enum": [
            "collecting_material",
            "clarifying",
            "understanding_ready",
            "confirmed_for_factory_start",
            "start_request_created",
            "blocked"
          ]
        },
        "rounds_completed": { "type": "integer", "minimum": 0 },
        "open_questions": {
          "type": "array",
          "items": { "type": "string", "minLength": 3 }
        },
        "max_questions_next_turn": { "type": "integer", "minimum": 0, "maximum": 5 }
      },
      "additionalProperties": false
    },
    "product_understanding_loop": {
      "type": "object",
      "required": [
        "operator_understanding_confirmation_required",
        "raw_material_not_assumed_complete",
        "dynamic_questions_allowed",
        "max_questions_per_turn",
        "minimum_questions_before_confirmation",
        "rich_material_requires_source_inventory",
        "brownfield_input_requires_brownfield_plan",
        "decision_briefing_required_before_sot",
        "confirmed_understanding_ref"
      ],
      "properties": {
        "operator_understanding_confirmation_required": { "const": true },
        "raw_material_not_assumed_complete": { "const": true },
        "dynamic_questions_allowed": { "const": true },
        "max_questions_per_turn": { "type": "integer", "minimum": 1, "maximum": 5 },
        "minimum_questions_before_confirmation": { "type": "integer", "minimum": 3, "maximum": 5 },
        "rich_material_requires_source_inventory": { "const": true },
        "brownfield_input_requires_brownfield_plan": { "const": true },
        "decision_briefing_required_before_sot": { "const": true },
        "confirmed_understanding_ref": { "type": "string", "minLength": 3 }
      },
      "additionalProperties": false
    },
    "factory_start_boundary": {
      "type": "object",
      "required": [
        "factory_start_forbidden_until_understanding_confirmed",
        "manager_compiles_conversation_before_start",
        "new_project_creates_fresh_hermes_board",
        "bridge_does_not_create_cards",
        "execution_forbidden_at_start_conversation"
      ],
      "properties": {
        "factory_start_forbidden_until_understanding_confirmed": { "const": true },
        "manager_compiles_conversation_before_start": { "const": true },
        "new_project_creates_fresh_hermes_board": { "const": true },
        "bridge_does_not_create_cards": { "const": true },
        "execution_forbidden_at_start_conversation": { "const": true }
      },
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "required": [
        "next_artifact",
        "next_worker",
        "factory_bridge_start_request_ref",
        "next_safe_action",
        "user_decision_required",
        "factory_owned_next_step"
      ],
      "properties": {
        "next_artifact": { "type": "string", "minLength": 3 },
        "next_worker": { "type": "string", "minLength": 3 },
        "factory_bridge_start_request_ref": { "type": "string", "minLength": 3 },
        "next_safe_action": { "type": "string", "minLength": 6 },
        "user_decision_required": { "type": "boolean" },
        "factory_owned_next_step": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "public_private_boundary": {
      "type": "object",
      "required": [
        "public_safe_refs_only",
        "raw_private_evidence_embedded",
        "private_context_retained_outside_public_repo",
        "operator_instance_may_hold_private_source"
      ],
      "properties": {
        "public_safe_refs_only": { "const": true },
        "raw_private_evidence_embedded": { "const": false },
        "private_context_retained_outside_public_repo": { "const": true },
        "operator_instance_may_hold_private_source": { "const": true }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "required": [
        "start_conversation_created",
        "factory_start_allowed",
        "execution_allowed",
        "operator_polling_required",
        "blocked_reason",
        "evidence_refs"
      ],
      "properties": {
        "start_conversation_created": { "const": true },
        "factory_start_allowed": { "type": "boolean" },
        "execution_allowed": { "const": false },
        "operator_polling_required": { "const": false },
        "blocked_reason": { "type": "string", "minLength": 6 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
