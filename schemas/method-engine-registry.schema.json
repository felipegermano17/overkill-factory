{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overkill-factory.dev/schemas/method-engine-registry.schema.json",
  "title": "Overkill Factory Method Engine Registry",
  "type": "object",
  "required": [
    "$schema",
    "record_type",
    "registry_id",
    "factory_method_version",
    "engines",
    "coverage_policy",
    "public_private_boundary"
  ],
  "properties": {
    "$schema": {
      "const": "https://overkill-factory.dev/schemas/method-engine-registry.schema.json"
    },
    "record_type": {
      "const": "method_engine_registry"
    },
    "registry_id": {
      "type": "string",
      "minLength": 3
    },
    "factory_method_version": {
      "const": "OVERKILL_VFINAL"
    },
    "engines": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "engine_id",
          "method_family",
          "display_name",
          "method_aliases",
          "trigger_routes",
          "required_artifacts",
          "required_gates",
          "required_workers",
          "proof_requirements",
          "forbidden_shortcuts",
          "operator_choice_required",
          "execution_allowed_by_engine_selection"
        ],
        "properties": {
          "engine_id": {
            "type": "string",
            "minLength": 3
          },
          "method_family": {
            "enum": [
              "spec_first",
              "test_first",
              "behavior_first",
              "discovery_first",
              "security_first",
              "design_first",
              "legacy_diagnosis",
              "incident_first"
            ]
          },
          "display_name": {
            "type": "string",
            "minLength": 3
          },
          "method_aliases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 2
            },
            "uniqueItems": true
          },
          "trigger_routes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            },
            "uniqueItems": true
          },
          "required_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            },
            "uniqueItems": true
          },
          "required_gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            },
            "uniqueItems": true
          },
          "required_workers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            },
            "uniqueItems": true
          },
          "proof_requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            },
            "uniqueItems": true
          },
          "forbidden_shortcuts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            },
            "uniqueItems": true
          },
          "operator_choice_required": {
            "const": false
          },
          "execution_allowed_by_engine_selection": {
            "const": false
          }
        },
        "additionalProperties": false
      }
    },
    "coverage_policy": {
      "type": "object",
      "required": [
        "method_label_cannot_authorize_execution",
        "operator_does_not_choose_internal_method",
        "all_engines_require_artifacts_gates_workers_and_proof"
      ],
      "properties": {
        "method_label_cannot_authorize_execution": { "const": true },
        "operator_does_not_choose_internal_method": { "const": true },
        "all_engines_require_artifacts_gates_workers_and_proof": { "const": true }
      },
      "additionalProperties": false
    },
    "public_private_boundary": {
      "type": "object",
      "required": [
        "public_safe_refs_only",
        "raw_private_evidence_embedded",
        "private_context_retained_outside_public_repo"
      ],
      "properties": {
        "public_safe_refs_only": { "const": true },
        "raw_private_evidence_embedded": { "const": false },
        "private_context_retained_outside_public_repo": { "const": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
