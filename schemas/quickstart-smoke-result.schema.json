{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overkill-factory.dev/schemas/quickstart-smoke-result.schema.json",
  "title": "Overkill Factory Quickstart Smoke Result",
  "type": "object",
  "required": [
    "$schema",
    "result_type",
    "created_at",
    "result",
    "card",
    "gate_status",
    "required_workers",
    "worker_packet_count",
    "worker_packet_dir",
    "checks",
    "next_step"
  ],
  "properties": {
    "$schema": { "const": "https://overkill-factory.dev/schemas/quickstart-smoke-result.schema.json" },
    "result_type": { "const": "quickstart_smoke_result" },
    "created_at": { "type": "string", "minLength": 10 },
    "result": { "enum": ["PASS", "FAIL"] },
    "card": { "type": "string", "minLength": 3 },
    "gate_status": { "type": "string", "minLength": 3 },
    "required_workers": {
      "type": "array",
      "items": { "type": "string", "minLength": 3 }
    },
    "worker_packet_count": { "type": "integer", "minimum": 0 },
    "worker_packet_dir": { "type": "string", "minLength": 3 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "result", "details"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "result": { "enum": ["PASS", "FAIL"] },
          "details": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "next_step": { "type": "string", "minLength": 8 }
  },
  "additionalProperties": false
}
