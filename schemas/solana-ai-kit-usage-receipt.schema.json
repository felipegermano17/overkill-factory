{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overkill-factory.dev/schemas/solana-ai-kit-usage-receipt.schema.json",
  "title": "Overkill Factory Solana AI Kit Usage Receipt",
  "type": "object",
  "required": [
    "$schema",
    "provider_id",
    "source",
    "pinned_ref",
    "loaded",
    "loaded_components",
    "evidence_refs"
  ],
  "properties": {
    "$schema": { "const": "https://overkill-factory.dev/schemas/solana-ai-kit-usage-receipt.schema.json" },
    "provider_id": { "const": "solana-ai-kit" },
    "source": { "const": "https://github.com/solanabr/solana-ai-kit" },
    "pinned_ref": { "const": "v2.0.2" },
    "loaded": { "const": true },
    "loaded_components": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    }
  },
  "additionalProperties": false
}
