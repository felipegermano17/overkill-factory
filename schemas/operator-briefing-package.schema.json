{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overkill-factory.dev/schemas/operator-briefing-package.schema.json",
  "title": "Overkill Factory Operator Briefing Package",
  "type": "object",
  "required": [
    "$schema",
    "record_type",
    "briefing_id",
    "created_at",
    "primary_interface_ref",
    "primary_interface",
    "target_artifact",
    "briefing_depth",
    "delivery_assets",
    "interface_projection",
    "decision_boundary",
    "proactive_delivery",
    "public_private_boundary",
    "acceptance"
  ],
  "properties": {
    "$schema": { "const": "https://overkill-factory.dev/schemas/operator-briefing-package.schema.json" },
    "record_type": { "const": "operator_briefing_package" },
    "briefing_id": { "type": "string", "minLength": 3 },
    "created_at": { "type": "string", "minLength": 10 },
    "primary_interface_ref": { "type": "string", "minLength": 3 },
    "primary_interface": { "enum": ["telegram", "discord", "cockpit", "codex_bridge", "cli", "api"] },
    "target_artifact": {
      "type": "object",
      "required": ["artifact_type", "artifact_ref", "stage", "decision_required"],
      "properties": {
        "artifact_type": { "type": "string", "minLength": 3 },
        "artifact_ref": { "type": "string", "minLength": 3 },
        "stage": { "type": "string", "minLength": 3 },
        "decision_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "briefing_depth": {
      "type": "object",
      "required": [
        "depth",
        "source_document_required",
        "pdf_required",
        "summary_only_forbidden_when_decision_required"
      ],
      "properties": {
        "depth": { "enum": ["status_package", "deep_decision_package"] },
        "source_document_required": { "const": true },
        "pdf_required": { "const": true },
        "summary_only_forbidden_when_decision_required": { "const": true }
      },
      "additionalProperties": false
    },
    "delivery_assets": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["kind", "asset_ref", "required_for_operator_decision", "purpose"],
        "properties": {
          "kind": {
            "enum": [
              "short_message",
              "markdown_document",
              "pdf_document",
              "diagram",
              "video_explainer",
              "audio_explainer",
              "raw_json",
              "source_link"
            ]
          },
          "asset_ref": { "type": "string", "minLength": 3 },
          "required_for_operator_decision": { "type": "boolean" },
          "purpose": { "type": "string", "minLength": 3 }
        },
        "additionalProperties": false
      }
    },
    "interface_projection": {
      "type": "object",
      "required": [
        "short_caption",
        "attachment_order",
        "fallback_when_attachment_fails",
        "max_questions_after_delivery"
      ],
      "properties": {
        "short_caption": { "type": "string", "minLength": 3 },
        "attachment_order": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "fallback_when_attachment_fails": { "type": "string", "minLength": 3 },
        "max_questions_after_delivery": { "type": "integer", "minimum": 0, "maximum": 5 }
      },
      "additionalProperties": false
    },
    "decision_boundary": {
      "type": "object",
      "required": [
        "briefing_is_not_source_of_truth",
        "approval_requires_human_gate_when_authority_risk_access_release",
        "operator_can_request_changes",
        "execution_not_allowed_from_briefing"
      ],
      "properties": {
        "briefing_is_not_source_of_truth": { "const": true },
        "approval_requires_human_gate_when_authority_risk_access_release": { "const": true },
        "operator_can_request_changes": { "const": true },
        "execution_not_allowed_from_briefing": { "const": true }
      },
      "additionalProperties": false
    },
    "proactive_delivery": {
      "type": "object",
      "required": ["push_required", "operator_polling_required", "notify_when_ready"],
      "properties": {
        "push_required": { "const": true },
        "operator_polling_required": { "const": false },
        "notify_when_ready": { "const": true }
      },
      "additionalProperties": false
    },
    "public_private_boundary": {
      "type": "object",
      "required": [
        "public_safe_refs_only",
        "raw_private_evidence_embedded",
        "private_context_retained_outside_public_repo",
        "operator_instance_may_hold_private_source"
      ],
      "properties": {
        "public_safe_refs_only": { "const": true },
        "raw_private_evidence_embedded": { "const": false },
        "private_context_retained_outside_public_repo": { "const": true },
        "operator_instance_may_hold_private_source": { "const": true }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "required": [
        "briefing_package_created",
        "deep_document_attached",
        "pdf_attached_or_required",
        "summary_only",
        "execution_allowed",
        "operator_polling_required",
        "evidence_refs"
      ],
      "properties": {
        "briefing_package_created": { "const": true },
        "deep_document_attached": { "const": true },
        "pdf_attached_or_required": { "const": true },
        "summary_only": { "const": false },
        "execution_allowed": { "const": false },
        "operator_polling_required": { "const": false },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
