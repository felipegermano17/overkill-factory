{
  "$schema": "https://overkill-factory.dev/schemas/factory-method-excellence-registry.schema.json",
  "record_type": "factory_method_excellence_registry",
  "registry_id": "factory-method-excellence-registry-v1",
  "mission": "Make Overkill Factory a reference-quality product methodology layer while Hermes remains the runtime floor.",
  "runtime_boundary": {
    "hermes_owns_runtime_floor": true,
    "overkill_owns_method_contracts_and_gates": true,
    "no_mini_hermes_runtime": true,
    "use_hermes_native_kanban_typed_blocks_dependencies_dispatch_first": true
  },
  "coverage_policy": {
    "method_label_cannot_authorize_execution": true,
    "operator_does_not_choose_internal_method_by_taste": true,
    "all_method_families_require_artifacts_gates_workers_proof_and_forbidden_shortcuts": true,
    "anti_mediocrity_quality_floor_required": true,
    "learnback_required_for_method_failures": true
  },
  "public_private_boundary": {
    "public_safe_refs_only": true,
    "raw_private_evidence_embedded": false,
    "private_context_retained_outside_public_repo": true
  },
